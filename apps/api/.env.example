# ---- Core ----
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio
# The API stays online and retries temporary Atlas/DNS failures automatically.
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_RETRY_MIN_MS=3000
MONGODB_RETRY_MAX_MS=30000
PUBLIC_CACHE_TTL_MS=60000
PUBLIC_CACHE_MAX_ENTRIES=250
# Optional shared production cache and distributed rate-limit store.
# Use redis:// or rediss://. The API safely falls back to in-process memory.
REDIS_URL=
# 32+ random chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-change-me-change-me-change-me
# Comma-separated list of browser origins allowed to call the API (CORS)
CLIENT_ORIGINS=http://localhost:3000
# Public URL of the website (used in emails + sitemap data)
PUBLIC_SITE_URL=http://localhost:3000
# Set true when API sits behind a proxy/load balancer (Render, Railway, Nginx…)
TRUST_PROXY=false

# ---- Cookies ----
# In production over HTTPS set COOKIE_SECURE=true.
COOKIE_SECURE=false
# lax works when the web app proxies /api (recommended). Use "none" only for cross-site setups (requires COOKIE_SECURE=true).
COOKIE_SAMESITE=lax

# ---- Admin bootstrap (used by `npm run admin:create`, never by the running server) ----
ADMIN_EMAIL=you@example.com
ADMIN_NAME=Owner
ADMIN_PASSWORD=
# One-time recovery only: permits admin:create to replace the sole existing
# owner's email and password. Remove or set false immediately after use.
ADMIN_REPLACE_EXISTING=false

# ---- Cloudinary (leave blank in dev to store uploads on local disk) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=portfolio

# ---- Email (Resend). Leave blank in dev: inquiries are stored and logged. ----
RESEND_API_KEY=
MAIL_FROM=Portfolio <onboarding@resend.dev>
# Where inquiry notifications are delivered
OWNER_EMAIL=you@example.com

# ---- Uploads ----
MAX_IMAGE_MB=8
MAX_DOC_MB=10
UPLOAD_DIR=uploads

# ---- Instant cache refresh (optional but recommended) ----
# After you publish/unpublish in the CMS the API calls this URL so the site updates immediately instead of within 60s.
# Both values must match the web app's REVALIDATE_SECRET.
REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=change-me-to-a-long-random-string
