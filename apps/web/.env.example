# Where the Express API lives. Server components call it directly; the browser calls /api/v1/* on THIS site,
# which Next proxies to the API (so session cookies stay first-party and CSRF is simple).
API_URL=http://localhost:4000
# Public URL of this site (canonical URLs, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: analytics (Plausible). Leave blank to disable; no cookies, no personal data.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Optional social profile URLs shown as icons beneath the footer headline.
# Leave any value blank to hide that platform.
NEXT_PUBLIC_SOCIAL_GITHUB_URL=
NEXT_PUBLIC_SOCIAL_LINKEDIN_URL=
NEXT_PUBLIC_SOCIAL_X_URL=
NEXT_PUBLIC_SOCIAL_INSTAGRAM_URL=
NEXT_PUBLIC_SOCIAL_FACEBOOK_URL=
NEXT_PUBLIC_SOCIAL_TIKTOK_URL=

# Shared secret the API uses to ask this site to refresh cached pages (must match the API's REVALIDATE_SECRET).
REVALIDATE_SECRET=change-me-to-a-long-random-string
